# Grants the gamepad group access to a PlayStation 5 DualSense controller,
# so the ADS Gamepad Service can read it without running as root.
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", GROUP="gamepad", MODE="0660"
# The same pad over Bluetooth appears as a HID device on bus 0005, where
# the USB vendor attributes do not exist; match the HID device name instead.
KERNEL=="hidraw*", KERNELS=="0005:054C:0CE6.*", GROUP="gamepad", MODE="0660"
