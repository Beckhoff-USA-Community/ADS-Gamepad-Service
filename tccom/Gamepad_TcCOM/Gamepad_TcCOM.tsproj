					<Name>CPP_Task</Name>
				</Task>
			</Tasks>
			<Modules>
				<Module Id="#x01010010" KeepUnrestoredLinks="2" ClassFactoryId="Beckhoff Community|ADS_Gamepad|0.0.0.7">
					<Name>Gamepad 1</Name>
					<ImageId>1000</ImageId>
					<TmcDesc GUID="{AAFF9BF9-C241-4CA6-B445-F3F9F22368C0}" ClassFactoryId="Beckhoff Community|ADS_Gamepad|0.0.0.7">
						<Name>Gamepad</Name>
						<CLSID ClassFactory="ADS_Gamepad">{4A519DAE-BC7D-F0F3-A4CB-3F944E0A3C28}</CLSID>
						<Info>
							<ImageData></ImageData>
						</Info>
						<Licenses>
							<License>
								<LicenseId>{304D006A-8299-4560-AB79-438534B50288}</LicenseId>
							</License>
						</Licenses>
						<InitSequence>PSO</InitSequence>
						<Contexts>
							<Context>
								<Id>1</Id>
								<ManualConfig>
									<OTCID>#x02010020</OTCID>
								</ManualConfig>
								<Priority>1</Priority>
								<CycleTime>10000000</CycleTime>
							</Context>
						</Contexts>
						<Interfaces>
							<Interface DisableCodeGeneration="true">
								<Type GUID="{00000012-0000-0000-E000-000000000064}">ITComObject</Type>
							</Interface>
							<Interface>
								<Type GUID="{03000010-0000-0000-E000-000000000064}">ITcCyclic</Type>
							</Interface>
							<Interface DisableCodeGeneration="true">
								<Type GUID="{03000012-0000-0000-E000-000000000064}">ITcADI</Type>
							</Interface>
							<Interface DisableCodeGeneration="true">
								<Type GUID="{03000018-0000-0000-E000-000000000064}">ITcWatchSource</Type>
							</Interface>
						</Interfaces>
						<Parameters>
							<Parameter>
								<Name>TraceLevelMax</Name>
								<Comment><![CDATA[Controls the amount of log messages.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{8007AE3B-86BB-40F2-B385-EF87FCC239A4}">TcTraceLevel</BaseType>
								<PTCID>#x03002103</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>ControllerNumber</Name>
								<Comment><![CDATA[Controller slot on the gamepad service, 1 to 4. Use one module instance per controller.]]></Comment>
								<BitSize>16</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
								<Default>
									<Value>1</Value>
								</Default>
								<PTCID>#x00000003</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>ServiceAmsNetId</Name>
								<Comment><![CDATA[AMS Net ID of the machine that runs the gamepad service. All zeros and 127.0.0.1.1.1 both mean the local system, the module then finds the real local address by itself.]]></Comment>
								<BitSize>48</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-000000000041}">AMSNETID</BaseType>
								<Default>
									<Data>7F0000010101</Data>
								</Default>
								<PTCID>#x00000004</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>TimeoutCycles</Name>
								<Comment><![CDATA[Task cycles without an ADS answer before the gamepad outputs are zeroed and the read is retried.]]></Comment>
								<BitSize>16</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-000000000005}">UINT</BaseType>
								<Default>
									<Value>1000</Value>
								</Default>
								<PTCID>#x00000005</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>StickDeadzonePercent</Name>
								<Comment TxtId=""><![CDATA[Stick deadzone in percent of full deflection, applied range 0 to 90. Deflection below the deadzone reads as zero, deflection above it rises smoothly from zero.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<Default>
									<Value>10.0</Value>
								</Default>
								<PTCID>#x00000006</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>StickCurve</Name>
								<Comment TxtId=""><![CDATA[Exponent on the stick deflection after the deadzone, applied range 0.25 to 8. A value of 1.0 is linear, 2.0 gives fine control near the center for jogging.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<Default>
									<Value>1.0</Value>
								</Default>
								<PTCID>#x00000007</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>TriggerDeadzonePercent</Name>
								<Comment TxtId=""><![CDATA[Trigger deadzone in percent of full travel, applied range 0 to 90. Travel below the deadzone reads as zero, travel above it rises smoothly from zero.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<Default>
									<Value>0.0</Value>
								</Default>
								<PTCID>#x00000008</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter>
								<Name>TriggerCurve</Name>
								<Comment TxtId=""><![CDATA[Exponent on the trigger travel after the deadzone, applied range 0.25 to 8. A value of 1.0 is linear, higher values give fine control at light pressure.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<Default>
									<Value>1.0</Value>
								</Default>
								<PTCID>#x00000009</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter OnlineParameter="true">
								<Name>OnlineStickDeadzonePercent</Name>
								<Comment TxtId=""><![CDATA[Live copy of StickDeadzonePercent, seeded from the init value when the module starts. Adjust it here while the machine runs, then copy the final value into StickDeadzonePercent to make it permanent.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<PTCID>#x0000000a</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter OnlineParameter="true">
								<Name>OnlineStickCurve</Name>
								<Comment TxtId=""><![CDATA[Live copy of StickCurve, seeded from the init value when the module starts.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<PTCID>#x0000000b</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter OnlineParameter="true">
								<Name>OnlineTriggerDeadzonePercent</Name>
								<Comment TxtId=""><![CDATA[Live copy of TriggerDeadzonePercent, seeded from the init value when the module starts.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<PTCID>#x0000000c</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
							<Parameter OnlineParameter="true">
								<Name>OnlineTriggerCurve</Name>
								<Comment TxtId=""><![CDATA[Live copy of TriggerCurve, seeded from the init value when the module starts.]]></Comment>
								<BitSize>32</BitSize>
								<BaseType GUID="{18071995-0000-0000-0000-00000000000D}">REAL</BaseType>
								<PTCID>#x0000000d</PTCID>
								<ContextId>1</ContextId>
							</Parameter>
						</Parameters>
