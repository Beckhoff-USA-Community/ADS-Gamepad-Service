									<Name>stButtons</Name>
									<Comment><![CDATA[Decoded button states, each TRUE while the button is pressed.]]></Comment>
									<BitSize>128</BitSize>
									<BaseType GUID="{0D2B4778-3608-4C16-9CA3-653934376D92}">ST_GamepadButtons</BaseType>
