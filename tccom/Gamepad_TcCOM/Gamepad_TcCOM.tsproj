									<BitSize>32</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000008}">UDINT</BaseType>
									<BitOffs>416</BitOffs>
								</Symbol>
								<Symbol>
									<Name>nDataAgeCycles</Name>
