									<Comment><![CDATA[Reserved, keeps the following members aligned.]]></Comment>
									<BitSize>8</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000001}">BYTE</BaseType>
									<BitOffs>16</BitOffs>
								</Symbol>
								<Symbol>
									<Name>nReserved3</Name>
									<Comment><![CDATA[Reserved, keeps the following members aligned.]]></Comment>
									<BitSize>8</BitSize>
									<BaseType GUID="{18071995-0000-0000-0000-000000000001}">BYTE</BaseType>
									<BitOffs>24</BitOffs>
								</Symbol>
