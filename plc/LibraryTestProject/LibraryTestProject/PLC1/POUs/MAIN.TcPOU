<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{6229c1e7-7648-4318-a777-35026c64ff5c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// Gamepad from the AdsGamepad library. An empty NetID means the local machine
	Gamepad			: FB_Gamepad_Controller('', 1);
	bEnableMover	: BOOL := TRUE;

	// Raw stick values. Mapping them onto axes or movers is application code
	fStickX			: LREAL;
	fStickY			: LREAL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Gamepad.Cycle();

// Read the left stick. The jog helper FBs are gone from the library, so how these
// values drive an axis or a mover is up to the application. See MIGRATION.md
fStickX := Gamepad.P_Left_Joystick.fX;
fStickY := Gamepad.P_Left_Joystick.fY;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>