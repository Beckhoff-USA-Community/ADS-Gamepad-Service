    <Property Name="P_SetRumble" Id="{e951a137-f153-4333-bf9b-6c5d979a71f2}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Status of the SetRumble method
PROPERTY P_SetRumble : REFERENCE TO ST_Gamepad_Command_Status]]></Declaration>
      <Get Name="Get" Id="{1009e700-d671-4ebf-b638-5a140a7d5a04}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_SetRumble REF= THIS^._rumbleCommand;

]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Status" Id="{9862bf27-d17e-48b2-b703-c886caf0e3f2}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Structure of the controller capabilites and status
PROPERTY P_Status : REFERENCE TO ST_Gamepad_Status]]></Declaration>
      <Get Name="Get" Id="{dabe201a-2054-48fe-a490-6ba481e4db51}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF THIS^.stGamepadInputs.bStatus.xConnected THEN	
	THIS^._stControllerStatus.bConnected 		:= TRUE;
	THIS^._stControllerStatus.bDisconnected 	:= FALSE;
	THIS^._stControllerStatus.iControllerNumber := THIS^.stGamepadInputs.iControllerNumber;
ELSE
	THIS^._stControllerStatus.bConnected 		:= FALSE;
	THIS^._stControllerStatus.bDisconnected 	:= TRUE;
	THIS^._stControllerStatus.iControllerNumber := 0;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Type_Disconnected THEN
	THIS^._stControllerStatus.eBattery_Type := E_Gamepad_Battery_Types.Disconnected;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Type_Wired THEN
	THIS^._stControllerStatus.eBattery_Type := E_Gamepad_Battery_Types.Wired;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Type_Alkaline THEN
	THIS^._stControllerStatus.eBattery_Type := E_Gamepad_Battery_Types.Alkaline;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Type_NIMH THEN
	THIS^._stControllerStatus.eBattery_Type := E_Gamepad_Battery_Types.NIMH;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Type_Unknown THEN
	THIS^._stControllerStatus.eBattery_Type := E_Gamepad_Battery_Types.Unknown;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Level_Empty THEN
	THIS^._stControllerStatus.eBattery_Level := E_Gamepad_Battery_Levels.Empty;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Level_Low THEN
	THIS^._stControllerStatus.eBattery_Level := E_Gamepad_Battery_Levels.Low;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Level_Medium THEN
	THIS^._stControllerStatus.eBattery_Level := E_Gamepad_Battery_Levels.Medium;
END_IF

IF THIS^.stGamepadInputs.bStatus.xBattery_Level_Full THEN
	THIS^._stControllerStatus.eBattery_Level := E_Gamepad_Battery_Levels.Full;
END_IF


P_Status REF= THIS^._stControllerStatus;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Handshake_State" Id="{4b8d8743-7e64-4acd-92cc-f0f888b71118}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Result of the version handshake with the service. Unsupported retries in the background
PROPERTY P_Handshake_State : E_Gamepad_Handshake_State]]></Declaration>
      <Get Name="Get" Id="{b65b4f8a-e296-4a52-a7bc-6418a223cdd4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_Handshake_State := THIS^._eHandshakeState;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Service_Info" Id="{4436cb86-453d-4f0a-b3c6-2ffb1d98d3d4}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Version and capability info read from the service during the handshake
PROPERTY P_Service_Info : REFERENCE TO ST_Gamepad_Service_Info]]></Declaration>
      <Get Name="Get" Id="{d5a3e756-38fe-474b-b5f1-43b52c7a9654}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_Service_Info REF= THIS^._stServiceInfo;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetRumble" Id="{321f1c4d-4b89-4b24-88d5-c2d524fc2f0a}">
      <Declaration><![CDATA[// Sets the rumble for the controller
METHOD SetRumble : BOOL
VAR_INPUT
	// Left motor speed (0..100%)
	fLeftMotor : REAL;
	// Right motor speed (0..100%)
	fRightMotor : REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// When the method is called, check if a write is in progress
IF THIS^._bSetRumbleEvent THEN
	// ADS you are doing that too much
	IF NOT THIS^._bSetRumbleEventLogged THEN
		ADSLOGSTR( msgCtrlMask := ADSLOG_MSGTYPE_WARN, msgFmtStr := 'PLC Msg.: Command being called too often, wait for done bit: %s', strArg := 'SetRumble()');
		THIS^._bSetRumbleEventLogged := TRUE;
	END_IF	
ELSE
	// Check if the value is within range
	IF fLeftMotor > 100 THEN
		THIS^._stRumble.fLeftMotor := 100.0;
	ELSIF fLeftMotor < 0 THEN
		THIS^._stRumble.fLeftMotor := 0.0;
	ELSE
		THIS^._stRumble.fLeftMotor := fLeftMotor;
	END_IF
	
	// Check if the value is within range
	IF fRightMotor > 100 THEN
		THIS^._stRumble.fRightMotor := 100.0;
	ELSIF fRightMotor < 0 THEN
		THIS^._stRumble.fRightMotor := 0.0;
	ELSE
		THIS^._stRumble.fRightMotor := fRightMotor;
	END_IF
	
	//Reset all status for the command
	THIS^.P_SetRumble.bDone := FALSE;
	THIS^.P_SetRumble.bBusy := FALSE;
	THIS^.P_SetRumble.bError := FALSE;

	// Set the high bit on the write command
	THIS^._bSetRumbleEvent := TRUE;
END_IF

// If it's done, set the current even in progress to false
IF P_SetRumble.bDone THEN
	THIS^._bSetRumbleEvent := FALSE;
END_IF

// Event Received
SetRumble := THIS^._bSetRumbleEvent;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadExtended" Id="{64a822aa-60ad-4d72-9056-f0bf18e94138}">
      <Declaration><![CDATA[// Reads the 96 byte extended block, wire contract 1.3. Call this once per
// PLC cycle in addition to Cycle when the extended data is wanted; it costs
// one extra ADS read per cycle and programs that never call it behave
// exactly as before. A service older than 2.5.0 answers with an error and
// the block then reads all zero, the same fail safe as everywhere else.
METHOD ReadExtended : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Read the current extended block
THIS^._ReadExtData(
	NETID:= THIS^._AmsNetId,
	PORT:= 25733,
	IDXGRP:= THIS^._IDXGRP + 16#100,
	IDXOFFS:= 0,
	LEN:= SIZEOF(THIS^.stGamepadExtInputs),
	DESTADDR:= ADR(THIS^.stGamepadExtInputs),
	READ:= TRUE,
	TMOUT:= T#5S,
	ERR=>);

// If there is an error in reading from the server, shut all values off
IF THIS^._ReadExtData.ERR THEN
	memset(ADR(THIS^.stGamepadExtInputs), 0, SIZEOF(THIS^.stGamepadExtInputs));
END_IF

// Stop read command
THIS^._ReadExtData(
	NETID:= THIS^._AmsNetId,
	PORT:= 25733,
	IDXGRP:= THIS^._IDXGRP + 16#100,
	IDXOFFS:= 0,
	LEN:= SIZEOF(THIS^.stGamepadExtInputs),
	DESTADDR:= ADR(THIS^.stGamepadExtInputs),
	READ:= FALSE,
	TMOUT:= T#5S,
	ERR=>);]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_Ext_Buttons" Id="{ca3a13c2-105b-4cff-af05-dcab0e8964f2}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Buttons beyond the classic surface, from the extended block
PROPERTY P_Ext_Buttons : REFERENCE TO ST_Gamepad_Ext_Buttons]]></Declaration>
      <Get Name="Get" Id="{0bbe9e48-aaeb-42dc-a91a-1c7979d6a3f2}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF (THIS^.stGamepadExtInputs.nExtFlags AND 16#0001) <> 0 THEN
	THIS^._stExtButtons.bPS 			:= (THIS^.stGamepadExtInputs.nExtButtons AND 16#0001) <> 0;
	THIS^._stExtButtons.bMute 			:= (THIS^.stGamepadExtInputs.nExtButtons AND 16#0002) <> 0;
	THIS^._stExtButtons.bTouchpad_Click := (THIS^.stGamepadExtInputs.nExtButtons AND 16#0004) <> 0;
ELSE
	THIS^._stExtButtons.bPS 			:= FALSE;
	THIS^._stExtButtons.bMute 			:= FALSE;
	THIS^._stExtButtons.bTouchpad_Click := FALSE;
END_IF
P_Ext_Buttons REF= THIS^._stExtButtons;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Touchpad" Id="{bcbebd39-73fc-472b-8ab9-b1f84162d742}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// The two touchpad contacts from the extended block
PROPERTY P_Touchpad : REFERENCE TO ST_Gamepad_Touchpad]]></Declaration>
      <Get Name="Get" Id="{7e713b45-8caf-4524-a002-636afad890ec}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF (THIS^.stGamepadExtInputs.nExtFlags AND 16#0001) <> 0 THEN
	THIS^._stTouchpad.stPoint1.bActive 		:= THIS^.stGamepadExtInputs.stTouch0.nActive <> 0;
	THIS^._stTouchpad.stPoint1.nContactId 	:= THIS^.stGamepadExtInputs.stTouch0.nContactId;
	THIS^._stTouchpad.stPoint1.nX 			:= THIS^.stGamepadExtInputs.stTouch0.nX;
	THIS^._stTouchpad.stPoint1.nY 			:= THIS^.stGamepadExtInputs.stTouch0.nY;
	THIS^._stTouchpad.stPoint2.bActive 		:= THIS^.stGamepadExtInputs.stTouch1.nActive <> 0;
	THIS^._stTouchpad.stPoint2.nContactId 	:= THIS^.stGamepadExtInputs.stTouch1.nContactId;
	THIS^._stTouchpad.stPoint2.nX 			:= THIS^.stGamepadExtInputs.stTouch1.nX;
	THIS^._stTouchpad.stPoint2.nY 			:= THIS^.stGamepadExtInputs.stTouch1.nY;
ELSE
	memset(ADR(THIS^._stTouchpad), 0, SIZEOF(THIS^._stTouchpad));
END_IF
P_Touchpad REF= THIS^._stTouchpad;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Motion" Id="{19bb57ab-f98c-4a7c-b0a8-dd003cbe6dd9}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Raw motion sensor values from the extended block
PROPERTY P_Motion : REFERENCE TO ST_Gamepad_Motion]]></Declaration>
      <Get Name="Get" Id="{514492b2-6707-4de9-af0a-1ef03fef6f0d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF (THIS^.stGamepadExtInputs.nExtFlags AND 16#0001) <> 0 THEN
	THIS^._stMotion.nGyroX 	:= THIS^.stGamepadExtInputs.nGyroX;
	THIS^._stMotion.nGyroY 	:= THIS^.stGamepadExtInputs.nGyroY;
	THIS^._stMotion.nGyroZ 	:= THIS^.stGamepadExtInputs.nGyroZ;
	THIS^._stMotion.nAccelX := THIS^.stGamepadExtInputs.nAccelX;
	THIS^._stMotion.nAccelY := THIS^.stGamepadExtInputs.nAccelY;
	THIS^._stMotion.nAccelZ := THIS^.stGamepadExtInputs.nAccelZ;
ELSE
	memset(ADR(THIS^._stMotion), 0, SIZEOF(THIS^._stMotion));
END_IF
P_Motion REF= THIS^._stMotion;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Ext_Battery" Id="{fd45460a-6ef2-4b70-bf02-865dc28f4dbc}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Battery state from the extended block, valid while bValid is TRUE
PROPERTY P_Ext_Battery : REFERENCE TO ST_Gamepad_Ext_Battery]]></Declaration>
      <Get Name="Get" Id="{4de1670b-c387-4d01-98c0-d30c5e8df3b4}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF (THIS^.stGamepadExtInputs.nExtFlags AND 16#0002) <> 0 THEN
	THIS^._stExtBattery.bValid 		:= TRUE;
	THIS^._stExtBattery.nPercent 	:= THIS^.stGamepadExtInputs.nBatteryPercent;
	THIS^._stExtBattery.bCharging 	:= (THIS^.stGamepadExtInputs.nBatteryFlags AND 16#01) <> 0;
	THIS^._stExtBattery.bFull 		:= (THIS^.stGamepadExtInputs.nBatteryFlags AND 16#02) <> 0;
ELSE
	THIS^._stExtBattery.bValid 		:= FALSE;
	THIS^._stExtBattery.nPercent 	:= 0;
	THIS^._stExtBattery.bCharging 	:= FALSE;
	THIS^._stExtBattery.bFull 		:= FALSE;
END_IF
P_Ext_Battery REF= THIS^._stExtBattery;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Sequence" Id="{64d16bed-4a84-41b0-924b-752cc55846a4}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Report counter from the extended block. A value that keeps moving proves
// the input stream is alive; a program can watchdog it
PROPERTY P_Sequence : UDINT]]></Declaration>
      <Get Name="Get" Id="{21263837-022c-4fce-bc76-71f25a485f36}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[P_Sequence := THIS^.stGamepadExtInputs.nSequence;]]></ST>
        </Implementation>
      </Get>
    </Property>
