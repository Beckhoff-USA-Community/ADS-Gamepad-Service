<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <POU Name="FB_Gamepad_Controller" Id="{16e61ff8-1d18-479b-8b07-5a4f238667a6}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute 'no_explicit_call' := 'do not call this FB directly, call Cycle instead'} 
FUNCTION_BLOCK FB_Gamepad_Controller
VAR
	{attribute 'hide'}
	_AmsNetId : T_AMSNETID;
	{attribute 'hide'}
	_WriteServerData : ADSWRITE;
	{attribute 'hide'}
	_ReadServerData : ADSREAD;
	// RAW ADS Inputs for debug (Use properties to access items)
	stGamepadInputs : ST_Gamepad_ADS_Inputs;
	{attribute 'hide'}
	_stRumble : ST_Gamepad_Rumble;
	{attribute 'hide'}
	_IDXGRP : UDINT;
	{attribute 'hide'}
	_rumbleCommand 			: ST_Gamepad_Command_Status;
	{attribute 'hide'}
	_stControllerButtons 	: ST_Gamepad_Buttons;
	{attribute 'hide'}
	_stControllerStatus		: ST_Gamepad_Status;
	{attribute 'hide'}
	_stLeftJoystick 		: ST_Gamepad_Joystick;
	{attribute 'hide'}
	_stRightJoystick 		: ST_Gamepad_Joystick;
	{attribute 'hide'}
	_fLeftTrigger 			: REAL;
	{attribute 'hide'}
	_fRightTrigger 			: REAL;
	{attribute 'hide'}
	_bSetRumbleEvent 		: BOOL; // Internal indication of an ADS write event
	{attribute 'hide'}
	_bSetRumbleEventLogged	: BOOL; // Check if the Set Rumble event is being called too many times
	{attribute 'hide'}
	_ReadServiceInfo : ADSREAD;
	{attribute 'hide'}
	_stServiceInfo : ST_Gamepad_Service_Info;
	{attribute 'hide'}
	_eHandshakeState : E_Gamepad_Handshake_State;
	{attribute 'hide'}
	_nHandshakeRetryCycles : UDINT; // Counts cycles between handshake retries after a failed attempt
	{attribute 'hide'}
	_ReadExtData : ADSREAD;
	// RAW extended block for debug (Use properties to access items)
	stGamepadExtInputs : ST_Gamepad_Ext_ADS_Inputs;
	{attribute 'hide'}
	_stExtButtons : ST_Gamepad_Ext_Buttons;
	{attribute 'hide'}
	_stTouchpad : ST_Gamepad_Touchpad;
	{attribute 'hide'}
	_stMotion : ST_Gamepad_Motion;
	{attribute 'hide'}
	_stExtBattery : ST_Gamepad_Ext_Battery;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Cycle" Id="{c4c654fa-155e-401b-8a85-1aefc3ab660f}">
      <Declaration><![CDATA[// This method is called cyclically to update the controller inputs
METHOD Cycle : BOOL

]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Read the current inputs
THIS^._ReadServerData(
	NETID:= THIS^._AmsNetId, 
	PORT:= 25733, 
	IDXGRP:= THIS^._IDXGRP, 
	IDXOFFS:= 0, 
	LEN:= SIZEOF(THIS^.stGamepadInputs), 
	DESTADDR:= ADR(THIS^.stGamepadInputs), 
	READ:= TRUE, 
	TMOUT:= T#5S,
	ERR=>);
	
// If there is an error in reading from the server, shut all inputs off
IF THIS^._ReadServerData.ERR THEN
	memset(ADR(THIS^.stGamepadInputs), 0, SIZEOF(THIS^.stGamepadInputs));
END_IF

// Stop read command
THIS^._ReadServerData(
	NETID:= THIS^._AmsNetId, 
	PORT:= 25733, 
	IDXGRP:= THIS^._IDXGRP, 
	IDXOFFS:= 0, 
	LEN:= SIZEOF(THIS^.stGamepadInputs), 
	DESTADDR:= ADR(THIS^.stGamepadInputs), 
	READ:= FALSE, 
	TMOUT:= T#5S,
	ERR=>);
	

// Handle any write requests for the rumble
// Write the new values
THIS^._WriteServerData(
	NETID:= THIS^._AmsNetId, 
	PORT:= 25733, 
	IDXGRP:= THIS^._IDXGRP, 
	IDXOFFS:= 16, 
	LEN:= SIZEOF(THIS^._stRumble), 
	SRCADDR:= ADR(THIS^._stRumble), 
	WRITE:= THIS^._bSetRumbleEvent, 
	TMOUT:= T#5S);
	
// Update the status of the current command if active
IF 	THIS^._bSetRumbleEvent THEN
	THIS^.P_SetRumble.bBusy := THIS^._WriteServerData.BUSY;
	THIS^.P_SetRumble.bError := THIS^._WriteServerData.ERR;
END_IF

// Check if it's done writing
IF THIS^._bSetRumbleEvent AND NOT THIS^._WriteServerData.BUSY THEN
	IF NOT THIS^._WriteServerData.ERR THEN
		THIS^.P_SetRumble.bDone := TRUE;
	END_IF
	// Turn off the write request
	THIS^._WriteServerData(
		NETID:= THIS^._AmsNetId, 
		PORT:= 25733, 
		IDXGRP:= THIS^._IDXGRP, 
		IDXOFFS:= 16, 
		LEN:= SIZEOF(THIS^._stRumble), 
		SRCADDR:= ADR(THIS^._stRumble), 
		WRITE:= FALSE, 
		TMOUT:= T#5S);

	THIS^._bSetRumbleEvent := FALSE;
END_IF

// Version handshake against the service info block at IndexGroup 16#F000.
// Services older than 2.1.0 answer with an error, which is fine. Data exchange works either way.
// A failed attempt reports Unsupported and retries in the background, so a service that starts
// after the PLC, for example right after an install, still gets a handshake without a PLC restart
CASE THIS^._eHandshakeState OF
	E_Gamepad_Handshake_State.NotStarted:
		THIS^._ReadServiceInfo(
			NETID:= THIS^._AmsNetId,
			PORT:= 25733,
			IDXGRP:= 16#F000,
			IDXOFFS:= 0,
			LEN:= SIZEOF(THIS^._stServiceInfo),
			DESTADDR:= ADR(THIS^._stServiceInfo),
			READ:= TRUE,
			TMOUT:= T#5S);
		THIS^._eHandshakeState := E_Gamepad_Handshake_State.Busy;

	E_Gamepad_Handshake_State.Busy:
		THIS^._ReadServiceInfo(READ:= TRUE);
		IF THIS^._ReadServiceInfo.ERR THEN
			// No answer. The service predates version 2.1.0 or it was not reachable, for example
			// while it was still starting. The Unsupported case below retries later
			memset(ADR(THIS^._stServiceInfo), 0, SIZEOF(THIS^._stServiceInfo));
			THIS^._eHandshakeState := E_Gamepad_Handshake_State.Unsupported;
			THIS^._ReadServiceInfo(READ:= FALSE);
		ELSIF NOT THIS^._ReadServiceInfo.BUSY THEN
			IF THIS^._stServiceInfo.nContractMajor = 1 THEN
				THIS^._eHandshakeState := E_Gamepad_Handshake_State.Compatible;
			ELSE
				ADSLOGSTR( msgCtrlMask := ADSLOG_MSGTYPE_WARN, msgFmtStr := 'PLC Msg.: The ADS Gamepad Service speaks a newer wire contract, update the AdsGamepad library: %s', strArg := 'FB_Gamepad_Controller');
				THIS^._eHandshakeState := E_Gamepad_Handshake_State.Mismatch;
			END_IF
			THIS^._ReadServiceInfo(READ:= FALSE);
		END_IF

	E_Gamepad_Handshake_State.Unsupported:
		// Retry the handshake in the background without leaving the reported state,
		// so consumers watching P_Handshake_State never see it flap. A genuinely old
		// service answers every retry with an error and the state simply stays
		// Unsupported; a service that was only starting late answers and the state
		// moves on. 5000 cycles is five seconds at a one millisecond PLC cycle
		THIS^._nHandshakeRetryCycles := THIS^._nHandshakeRetryCycles + 1;
		IF THIS^._nHandshakeRetryCycles >= 5000 THEN
			THIS^._ReadServiceInfo(
				NETID:= THIS^._AmsNetId,
				PORT:= 25733,
				IDXGRP:= 16#F000,
				IDXOFFS:= 0,
				LEN:= SIZEOF(THIS^._stServiceInfo),
				DESTADDR:= ADR(THIS^._stServiceInfo),
				READ:= TRUE,
				TMOUT:= T#5S);
			IF THIS^._ReadServiceInfo.ERR THEN
				// Still no answer; reset the read and count up to the next attempt
				memset(ADR(THIS^._stServiceInfo), 0, SIZEOF(THIS^._stServiceInfo));
				THIS^._ReadServiceInfo(READ:= FALSE);
				THIS^._nHandshakeRetryCycles := 0;
			ELSIF NOT THIS^._ReadServiceInfo.BUSY THEN
				IF THIS^._stServiceInfo.nContractMajor = 1 THEN
					THIS^._eHandshakeState := E_Gamepad_Handshake_State.Compatible;
				ELSE
					ADSLOGSTR( msgCtrlMask := ADSLOG_MSGTYPE_WARN, msgFmtStr := 'PLC Msg.: The ADS Gamepad Service speaks a newer wire contract, update the AdsGamepad library: %s', strArg := 'FB_Gamepad_Controller');
					THIS^._eHandshakeState := E_Gamepad_Handshake_State.Mismatch;
				END_IF
				THIS^._ReadServiceInfo(READ:= FALSE);
				THIS^._nHandshakeRetryCycles := 0;
			END_IF
		END_IF
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="FB_init" Id="{5ca1819e-d48f-4374-9f4b-b509d7da22ed}">
      <Declaration><![CDATA[METHOD FB_init : BOOL
VAR_INPUT
	bInitRetains : BOOL; // if TRUE, the retain variables are initialized (warm start / cold start)
	bInCopyCode : BOOL;  // if TRUE, the instance afterwards gets moved into the copy code (online change)
	NetID 				: T_AMSNETID := ''; // AMS Net ID of the ADS Gamepad Service
	iControllerNumber 	: UINT(1..4) := 1; // The controller number for the controller you'd like to use
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^._AmsNetId := NetID;
THIS^._IDXGRP := iControllerNumber * 16#10000;]]></ST>
      </Implementation>
    </Method>
    <Property Name="P_Buttons" Id="{9ecee726-55c8-4ab8-9170-a864e7a68da5}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Structure of the different active buttons
PROPERTY P_Buttons : REFERENCE TO ST_Gamepad_Buttons]]></Declaration>
      <Get Name="Get" Id="{fabea6d4-f972-48bb-9b75-17006ffd152b}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF THIS^.stGamepadInputs.bStatus.xConnected THEN	
	THIS^._stControllerButtons.DPad.bUp				:= THIS^.stGamepadInputs.bButtons.xDPAD_UP;
	THIS^._stControllerButtons.DPad.bDown			:= THIS^.stGamepadInputs.bButtons.xDPAD_DOWN;
	THIS^._stControllerButtons.DPad.bLeft			:= THIS^.stGamepadInputs.bButtons.xDPAD_LEFT;
	THIS^._stControllerButtons.DPad.bRight			:= THIS^.stGamepadInputs.bButtons.xDPAD_RIGHT;
	THIS^._stControllerButtons.bStart  				:= THIS^.stGamepadInputs.bButtons.xSTART;
	THIS^._stControllerButtons.bBack  				:= THIS^.stGamepadInputs.bButtons.xBACK;
	THIS^._stControllerButtons.bLeft_Thumbstick  	:= THIS^.stGamepadInputs.bButtons.xLEFT_THUMB;
	THIS^._stControllerButtons.bRight_Thumbstick 	:= THIS^.stGamepadInputs.bButtons.xRIGHT_THUMB;
	THIS^._stControllerButtons.bLeft_Shoulder  		:= THIS^.stGamepadInputs.bButtons.xLEFT_SHOULDER;
	THIS^._stControllerButtons.bRight_Shoulder  	:= THIS^.stGamepadInputs.bButtons.xRIGHT_SHOULDER;
	THIS^._stControllerButtons.bA_Button  			:= THIS^.stGamepadInputs.bButtons.xA;
	THIS^._stControllerButtons.bB_Button  			:= THIS^.stGamepadInputs.bButtons.xB;
	THIS^._stControllerButtons.bX_Button  			:= THIS^.stGamepadInputs.bButtons.xX;
	THIS^._stControllerButtons.bY_Button  			:= THIS^.stGamepadInputs.bButtons.xY;
ELSE
	THIS^._stControllerButtons.DPad.bUp				:= FALSE;
	THIS^._stControllerButtons.DPad.bDown			:= FALSE;
	THIS^._stControllerButtons.DPad.bLeft			:= FALSE;
	THIS^._stControllerButtons.DPad.bRight			:= FALSE;
	THIS^._stControllerButtons.bStart  				:= FALSE;
	THIS^._stControllerButtons.bBack  				:= FALSE;
	THIS^._stControllerButtons.bLeft_Thumbstick  	:= FALSE;
	THIS^._stControllerButtons.bRight_Thumbstick 	:= FALSE;
	THIS^._stControllerButtons.bLeft_Shoulder  		:= FALSE;
	THIS^._stControllerButtons.bRight_Shoulder  	:= FALSE;
	THIS^._stControllerButtons.bA_Button  			:= FALSE;
	THIS^._stControllerButtons.bB_Button  			:= FALSE;
	THIS^._stControllerButtons.bX_Button  			:= FALSE;
	THIS^._stControllerButtons.bY_Button  			:= FALSE;
END_IF
P_Buttons REF= THIS^._stControllerButtons;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="P_Left_Joystick" Id="{33db2771-a51a-47cd-87e9-82222a82ae74}">
      <Declaration><![CDATA[{attribute 'monitoring':='call'}
// Returns a structure of data for the XY Joystick values
PROPERTY P_Left_Joystick : REFERENCE TO ST_Gamepad_Joystick]]></Declaration>
      <Get Name="Get" Id="{4b140f7b-8969-4350-962e-103fcb9f7ed9}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IF THIS^.stGamepadInputs.bStatus.xConnected THEN	
	THIS^._stLeftJoystick.fX := THIS^.stGamepadInputs.stLeft_Joystick.fX;
	THIS^._stLeftJoystick.fY := THIS^.stGamepadInputs.stLeft_Joystick.fY;
ELSE
	THIS^._stLeftJoystick.fX := 0;
	THIS^._stLeftJoystick.fY := 0;
END_IF
P_Left_Joystick REF= THIS^._stLeftJoystick;]]></ST>
        </Implementation>
      </Get>
    </Property>
