<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.11">
  <DUT Name="ST_Gamepad_Touch_Point" Id="{6d9d7c0b-bf12-4665-aab9-95559660d5e8}">
    <Declaration><![CDATA[// One finger on the touchpad in friendly form.
TYPE ST_Gamepad_Touch_Point :
STRUCT
	// TRUE while the finger touches the pad
	bActive		: BOOL;
	// Counts contacts, so a new touch gets a new number
	nContactId	: USINT;
	// Position across the pad, 0 to 1919
	nX			: UINT;
	// Position down the pad, 0 to 1079
	nY			: UINT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
