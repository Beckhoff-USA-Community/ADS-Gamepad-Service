<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Beckhoff-USA-Community.XAR.Service.AdsGamepad</id>
    <version>2.1.0</version>
    <title>ADS Gamepad Service</title>
    <authors>Beckhoff Automation LLC</authors>
    <projectUrl>https://github.com/Beckhoff-USA-Community/ADS-Gamepad-Service</projectUrl>
    <copyright>(c) Beckhoff Automation LLC</copyright>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <readme>docs/README.md</readme>
    <summary>Gamepad to PLC bridge service for TwinCAT runtime systems</summary>
    <tags>Beckhoff Setup SystemServiceRestart</tags>
    <releaseNotes>Version 2.1.0 answers a version request on a reserved ADS index group so the PLC library and the TcCOM module can check that service and library fit together. The install location moved to C:\Program Files\Beckhoff USA Community\ADS Gamepad\Service. An upgrade moves an existing installation there and keeps its appsettings.json.</releaseNotes>
    <description>ADS Gamepad Service reads game controllers on a TwinCAT system and serves their state to the PLC over ADS. This version supports Xbox controllers through the XInput interface; PlayStation DualSense support is planned for a later release. The service registers ADS port 25733 with the local router and answers the reads issued by the companion PLC library. It runs as a Windows service with delayed automatic start and keeps its settings in an appsettings.json file next to the executable.</description>
    <dependencies>
      <dependency id="TwinCAT.XAR.AdsApi" version="0.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="bin\**" target="tools\bin" />
    <file src="docs\README.md" target="docs\README.md" />
    <file src="LICENSE.txt" target="LICENSE.txt" />
  </files>
</package>
