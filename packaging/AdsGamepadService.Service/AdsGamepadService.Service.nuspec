<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Beckhoff-USA-Community.XAR.Service.AdsGamepad</id>
    <version>2.7.0</version>
    <title>ADS Gamepad Service</title>
    <authors>Beckhoff Automation LLC</authors>
    <projectUrl>https://github.com/Beckhoff-USA-Community/ADS-Gamepad-Service</projectUrl>
    <copyright>(c) Beckhoff Automation LLC</copyright>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <readme>docs/README.md</readme>
    <summary>Gamepad to PLC bridge service for TwinCAT runtime systems</summary>
    <tags>Beckhoff Setup SystemServiceRestart</tags>
    <releaseNotes>Version 2.7.0 adds Bluetooth support for the PlayStation 5 DualSense on Windows. The existing DualSense slot setting covers both transports: pair the pad in the Windows Bluetooth settings and the service finds it, with the cable preferred when both are present. Bluetooth report checksums are verified in both directions. The wire contract is unchanged at 1.4.</releaseNotes>
    <description>ADS Gamepad Service reads game controllers on a TwinCAT system and serves their state to the PLC over ADS. It supports Xbox controllers through the XInput interface and PlayStation 5 DualSense controllers over USB or Bluetooth, selectable per controller slot. The service registers ADS port 25733 with the local router and answers the reads issued by the companion PLC library. It runs as a Windows service with delayed automatic start and keeps its settings in an appsettings.json file next to the executable.</description>
    <dependencies>
      <dependency id="TwinCAT.XAR.AdsApi" version="0.0.0" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="bin\**" target="tools\bin" />
    <file src="docs\README.md" target="docs\README.md" />
    <file src="LICENSE.txt" target="LICENSE.txt" />
  </files>
</package>
