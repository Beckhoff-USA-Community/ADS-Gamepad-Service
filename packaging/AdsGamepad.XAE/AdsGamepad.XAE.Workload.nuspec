<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Beckhoff-USA-Community.AdsGamepad.XAE</id>
    <version>2.12.1</version>
    <title>ADS Gamepad</title>
    <authors>Beckhoff Automation LLC</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <readme>docs/README.md</readme>
    <projectUrl>https://github.com/Beckhoff-USA-Community/ADS-Gamepad-Service</projectUrl>
    <description>This workload sets up an engineering system for the ADS Gamepad Service. It installs the AdsGamepad PLC library, the documentation, and the compiled Gamepad TcCOM module. The library lands in the XAE library repository ready to reference, and the module lands in the TwinCAT module repository ready to add to a project. The matching runtime workload installs the service itself.</description>
    <copyright>(c) Beckhoff Automation LLC</copyright>
    <tags>Beckhoff TwinCAT Workload CategoryBeckhoff&#160;USA&#160;Community VariantXAE</tags>
    <packageTypes>
      <packageType name="Workload" />
    </packageTypes>
    <dependencies>
      <dependency id="Beckhoff-USA-Community.XAE.PLC.Lib.AdsGamepad" version="2.3.0" />
      <dependency id="Beckhoff-USA-Community.XAE.Documentation.AdsGamepad" version="1.9.0" />
      <dependency id="Beckhoff-USA-Community.XAE.TcCom.AdsGamepad" version="0.0.0.12" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="docs\README.md" target="docs\README.md" />
    <file src="LICENSE.txt" target="LICENSE.txt" />
  </files>
</package>
