<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Beckhoff-USA-Community.AdsGamepad.XAE</id>
    <version>2.8.0</version>
    <title>ADS Gamepad</title>
    <authors>Beckhoff Automation LLC</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <readme>docs/README.md</readme>
    <projectUrl>https://github.com/Beckhoff-USA-Community/ADS-Gamepad-Service</projectUrl>
    <description>This workload sets up an engineering system for the ADS Gamepad Service. It installs the AdsGamepad PLC library, the documentation, and the source of the TcCOM module. The library also lands in the XAE library repository, ready to reference. The matching runtime workload installs the service itself.</description>
    <copyright>(c) Beckhoff Automation LLC</copyright>
    <tags>Beckhoff TwinCAT Workload CategoryBeckhoff&#160;USA&#160;Community&#160;&#124;&#160;Gamepad VariantXAE</tags>
    <packageTypes>
      <packageType name="Workload" />
    </packageTypes>
    <dependencies>
      <dependency id="Beckhoff-USA-Community.XAE.PLC.Lib.AdsGamepad" version="2.2.1" />
      <dependency id="Beckhoff-USA-Community.XAE.Documentation.AdsGamepad" version="1.5.0" />
      <dependency id="Beckhoff-USA-Community.XAE.TcComSource.AdsGamepad" version="0.0.0.11" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
    <file src="docs\README.md" target="docs\README.md" />
    <file src="LICENSE.txt" target="LICENSE.txt" />
  </files>
</package>
